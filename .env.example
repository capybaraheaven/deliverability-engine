# Smartlead: Settings -> API key. Passed as ?api_key= on every request.
SMARTLEAD_API_KEY=

# Zapmail: Settings -> API. Sent as the Authorization header.
ZAPMAIL_API_KEY=
# Optional. Scopes reads to one Zapmail workspace; omit to use the account default.
ZAPMAIL_WORKSPACE_KEY=

# State store. Leave DATABASE_URL empty to use the local SQLite file instead.
# Supabase: Project Settings -> Database -> Connection string (URI, session pooler).
DATABASE_URL=
SQLITE_PATH=state.db

# Optional. Slack incoming webhook for the run digest.
SLACK_WEBHOOK_URL=
