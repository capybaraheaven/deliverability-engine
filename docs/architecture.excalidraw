  {
   "type": "text",
   "id": "t700730",
   "x": 740,
   "y": 776,
   "width": 435,
   "height": 65,
   "text": "A replacement mailbox joins the campaign at 8 sends\na day and gains 6 more each day it stays healthy,\nstopping at 30. Giving a fresh mailbox full volume on\nday one burns it the same way the old one burned.",
   "originalText": "A replacement mailbox joins the campaign at 8 sends\na day and gains 6 more each day it stays healthy,\nstopping at 30. Giving a fresh mailbox full volume on\nday one burns it the same way the old one burned.",
