  {
   "type": "text",
   "id": "t700760",
   "x": 80,
   "y": 954,
   "width": 618,
   "height": 60,
   "text": "REPLACE   sendtemplify.com      listed on SURBL multi, keep sending until 2026-09-17\nBENCH     noah@templifyapp.com  warm-up reputation 91 of 100, below 98\nRETIRE    noah@templifyapp.com  burnt mailboxes are replaced\nESCALATE  usetemplify.com       past the 3-replacement cap this run",
   "originalText": "REPLACE   sendtemplify.com      listed on SURBL multi, keep sending until 2026-09-17\nBENCH     noah@templifyapp.com  warm-up reputation 91 of 100, below 98\nRETIRE    noah@templifyapp.com  burnt mailboxes are replaced\nESCALATE  usetemplify.com       past the 3-replacement cap this run",
   "fontSize": 12,
